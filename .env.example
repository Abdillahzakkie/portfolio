# ---------------------------------------------------------------------------
# Example environment. Copy to `.env.local` for local dev and fill real values.
# `.env` / `.env*.local` are gitignored (ACCEPTANCE #7). Commit ONLY this file.
# Contains NO real secrets — every value here is a safe placeholder/default.
# ---------------------------------------------------------------------------

# MongoDB connection string. Dev default points at the shared Docker Mongo on
# localhost:27018. Prod (Vercel) sets this to the Atlas SRV URI via the dashboard
# secret store — never hard-code an Atlas URI here.
MONGODB_URI=mongodb://localhost:27018/portfolio

# Database name. Forced by src/server/db/connect.ts so this app keeps its own
# namespace on the shared Mongo instance and never collides with other projects.
MONGODB_DB=portfolio

# Secret used by `jose` to sign/verify the httpOnly admin session-cookie JWT.
# MUST be replaced with a long random value in every real environment
# (e.g. `openssl rand -base64 48`). The placeholder below is intentionally weak
# so a misconfigured deploy is obvious. Never commit the real value.
AUTH_SECRET=change-me-in-prod

# Name of the httpOnly session cookie the auth layer sets on login.
AUTH_COOKIE_NAME=az_session

# Public site origin, used for canonical URLs, sitemap.xml, RSS, and OG tags.
# NEXT_PUBLIC_* is exposed to the browser bundle — keep it non-secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional footer contact links (non-secret, exposed to the browser).
NEXT_PUBLIC_GITHUB_URL=https://github.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# ---------------------------------------------------------------------------
# Seed admin account (used ONLY by `pnpm seed` to create the first CMS user).
# Set these in `.env.local` before seeding. The seed bcrypt-hashes the password
# and never stores or commits plaintext. If unset, the seed falls back to a
# clearly-marked dev default and PRINTS the credentials to the console.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=change-me-local-only
